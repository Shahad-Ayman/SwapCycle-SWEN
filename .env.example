# Copy to .env (never commit .env) and replace every placeholder.

# PostgreSQL (docker-compose)
POSTGRES_DB=swapcycle
POSTGRES_USER=swapcycle
POSTGRES_PASSWORD=change-me

# Backend
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Origin allowed by CORS (only needed when the frontend is served from another origin).
FRONTEND_ORIGIN=http://localhost:5173
# Keep true. Set false only if your browser rejects Secure cookies on plain-http localhost.
COOKIE_SECURE=true
PORT=8080
DB_POOL_SIZE=8

# Frontend (Vite dev server proxies /api to this address)
VITE_API_PROXY_TARGET=http://localhost:8080
